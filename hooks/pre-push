#!/usr/bin/env bash
# gensokyo-private pre-push: the `private` branch never leaves this machine.
#
# Refuses, for every ref in the push:
#   * pushing the local `private` branch (under any remote name), and
#   * pushing anything else whose history contains `private` -- so a public or
#     ci branch that accidentally merged private is caught too.
# Pushes to `public` and `ci` are otherwise untouched.
#
# Override (you really do mean it, e.g. a trusted mirror):
#   GENSOKYO_PUSH_PRIVATE=1 git push <remote> private
#
# Installed by hooks/install.sh (copied into .git/hooks, so it stays active on
# every branch). Invoked by git as: pre-push <remote name> <remote url>, with
# one "<local ref> <local sha> <remote ref> <remote sha>" line per ref on stdin.
set -u

remote=$1
url=$2
protected=refs/heads/private
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue

  if [ "$remote_ref" = "$protected" ] || [ "$local_ref" = "$protected" ]; then
    if [ "${GENSOKYO_PUSH_PRIVATE:-}" = 1 ]; then
      echo "pre-push: GENSOKYO_PUSH_PRIVATE=1, allowing $local_ref -> $remote ($url) $remote_ref" >&2
      continue
    fi
    echo "pre-push: refusing $local_ref -> $remote ($url) $remote_ref" >&2
    echo "pre-push:   the private branch is never pushed; GENSOKYO_PUSH_PRIVATE=1 overrides" >&2
    status=1
    continue
  fi

  # deletes carry no local sha, nothing to inspect
  [ "$local_sha" != "$zero" ] || continue

  if git show-ref --verify --quiet "$protected" \
     && git merge-base --is-ancestor "$protected" "$local_sha"; then
    if [ "${GENSOKYO_PUSH_PRIVATE:-}" = 1 ]; then
      echo "pre-push: GENSOKYO_PUSH_PRIVATE=1, allowing $local_ref (contains private) -> $remote $remote_ref" >&2
      continue
    fi
    echo "pre-push: refusing $local_ref -> $remote ($url) $remote_ref" >&2
    echo "pre-push:   its history contains the private branch (did you merge private into it?)" >&2
    status=1
  fi
done

exit $status
